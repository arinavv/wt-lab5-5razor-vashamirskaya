@page
@model DetailsModel
@{
    ViewData["Title"] = "Детали счёта";
}

<div class="container mt-4">
    <h1>Детали счёта</h1>

    <div class="card shadow-sm rounded-3 mt-3" style="max-width: 500px;">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Account.Id</p>
            <p><strong>Владелец (Название):</strong> @Model.Account.OwnerName</p>
            <p><strong>Тип (Категория):</strong> @Model.Account.AccountType</p>
            <p><strong>Баланс (Цена):</strong> @Model.Account.Balance BYN</p>
            
            <a asp-page="./Index" class="btn btn-secondary mt-3">Назад к списку</a>
        </div>
    </div>
</div>