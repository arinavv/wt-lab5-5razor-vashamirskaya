@page
@model IndexModel
@{
    ViewData["Title"] = "Каталог счетов";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold"><i class="bi bi-wallet2 text-primary"></i> Каталог счетов</h1>
            <p class="text-muted">Список объектов предметной области</p>
        </div>
        <a asp-page="/BankAccounts/Create" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Добавить
        </a>
    </div>

    <div class="row g-4">
        @foreach (var account in Model.Accounts)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card h-100 shadow rounded border-0 hover-card">

                    <img src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=400&q=80" class="card-img-top rounded-top" alt="Bank Card" style="height: 140px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary">ID: @account.Id</span>
                            <span class="badge bg-info text-dark"><i class="bi bi-tag-fill"></i> @account.AccountType</span>
                        </div>

                        <h5 class="card-title fw-bold">@account.OwnerName</h5>

                        <p class="fs-4 fw-bold text-success mb-3 mt-auto">
                            @account.Balance.ToString("N2") <small class="fs-6">BYN</small>
                        </p>

                        <div class="d-flex justify-content-between gap-2 mt-auto">
                            <a asp-page="/BankAccounts/Details" asp-route-id="@account.Id" class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye"></i> Подробнее
                            </a>
                            <a asp-page="/BankAccounts/Edit" asp-route-id="@account.Id" class="btn btn-outline-warning w-100">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>

</div>