@page
@model CreateModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow rounded">
                <div class="card-body">
                    <h2 class="mb-4">Добавление счёта</h2>

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Account.OwnerName" class="form-label">Имя владельца</label>
                            <input asp-for="Account.OwnerName" class="form-control" />
                            <span asp-validation-for="Account.OwnerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Account.Balance" class="form-label">Баланс</label>
                            <input asp-for="Account.Balance" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Account.Balance" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Account.AccountType" class="form-label">Тип счёта</label>
                            <input asp-for="Account.AccountType" class="form-control" />
                            <span asp-validation-for="Account.AccountType" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}